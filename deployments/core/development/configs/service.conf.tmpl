server {
    listen 80;
    server_name ${SERVICE_DOMAIN}.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SERVICE_DOMAIN}.${DOMAIN};

    http2 on;

    access_log /dev/stdout json;
    access_log syslog:server=rsyslog.${DOMAIN},tag=${SYSLOG_TAG},severity=info json;
    error_log  syslog:server=rsyslog.${DOMAIN},tag=${SYSLOG_TAG},severity=info;

    # Authelia, only for services with ':auth', see authelia-location.conf.
    ${AUTH_LOCATION}

    location / {
        # A variable makes nginx resolve the upstream per request, see the resolver in nginx.conf.
        set $upstream ${UPSTREAM_SCHEME}://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_pass $upstream;

        # Authelia, only for services with ':auth', see authelia-authrequest.conf.
        ${AUTH_REQUEST}

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Request-ID $request_id;
        proxy_set_header X-Request-ID $request_id;
    }
}
