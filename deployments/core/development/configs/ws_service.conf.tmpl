server {
    listen 80;
    server_name ${SERVICE_DOMAIN}.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ${SERVICE_DOMAIN}.${DOMAIN};

    http2 on;

    # Uploads, e.g. Vaultwarden attachments and ISOs through the Proxmox UI.
    client_max_body_size 525M;

    access_log /dev/stdout json;
    access_log syslog:server=rsyslog.${DOMAIN},tag=${SERVICE_DOMAIN},severity=info json;
    error_log  syslog:server=rsyslog.${DOMAIN},tag=${SERVICE_DOMAIN},severity=info;

    location / {
        # A variable makes nginx resolve the upstream per request, see the resolver in nginx.conf.
        set $upstream ${UPSTREAM_SCHEME}://${UPSTREAM_HOST}:${UPSTREAM_PORT};
        proxy_pass $upstream;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header X-Request-ID $request_id;
        proxy_set_header X-Request-ID $request_id;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 3600;
        proxy_send_timeout 3600;
    }
}
