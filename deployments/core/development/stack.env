# -----------------------------------------------------
# Deployment
# -----------------------------------------------------
THIS=$(realpath "$BASH_SOURCE")
HERE=$(dirname "$THIS")

export ENVIRONMENT_BASE=$(dirname "$THIS")
DEPLOYMENT_BASE=$(dirname "$ENVIRONMENT_BASE")

export ENVIRONMENT=$(basename "$ENVIRONMENT_BASE")
export DEPLOYMENT=$(basename "$DEPLOYMENT_BASE")

export CONFIGS="${ENVIRONMENT_BASE}/configs"
export SECRETS="${ENVIRONMENT_BASE}/secrets"

export STACK_PATH=$(realpath "$HERE/../../../")
export STACK_BASE=$(basename "$STACK_PATH" | sed 's/^stack\-//')
export STACK="${STACK_BASE}_${DEPLOYMENT}"

export CONTEXT="${ENVIRONMENT}.${DEPLOYMENT}"

# -----------------------------------------------------
# Images
# -----------------------------------------------------
NGINX_VERSION="1.31.3"
export NGINX_IMAGE="nginx:${NGINX_VERSION}"

# -----------------------------------------------------
# Configuration
# -----------------------------------------------------
# Replicas run on nodes labelled nginx_core_nginx, one per node.

# LoadBalancer IP, announced by kube-vip.
# TODO: Set once the development cluster is built.
export NGINX_LB_IP=""

# Let's Encrypt, use https://acme-staging-v02.api.letsencrypt.org/directory to test.
export ACME_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"

# Authelia (stack-authelia), asked about every request to a service with ":auth".
export NGINX_AUTHELIA_URL="http://authelia.authelia-core.svc.cluster.local:9091"

# Break-glass, "false" deploys every service without Authelia, e.g. while it's broken.
export NGINX_AUTH_ENABLED="true"

# Services are scheme:subdomain:host:port[:auth], ":auth" puts them behind Authelia. Hosts in the
# cluster need the full name (<service>.<namespace>.svc.cluster.local), they're resolved when a
# request is made.
export NGINX_SERVICES=""
export NGINX_WS_SERVICES=""
