user nginx;
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    include /etc/nginx/conf.d/logs.conf;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    server_tokens off;

    keepalive_timeout 65;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml;

    # Upstreams are resolved per request (see the proxy_host configs), so nginx starts even if one
    # doesn't resolve yet (e.g. pihole2 before the replica exists) and follows pod IP changes.
    # Names must be fully qualified, e.g. pihole-web.pihole-core.svc.cluster.local.
    resolver kube-dns.kube-system.svc.cluster.local valid=30s ipv6=off;

    # Fail fast (504) when an upstream is unreachable, rather than hanging for the 60s default.
    proxy_connect_timeout 5s;

    # TLS config, the wildcard cert is issued by cert-manager.
    ssl_certificate     /etc/nginx/ssl/tls.crt;
    ssl_certificate_key /etc/nginx/ssl/tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305;

    # Headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    # Without this any add_header in a server/location (e.g. X-Request-ID) drops the headers above.
    add_header_inherit merge;

    # Default server, also used by the k8s probes.
    server {
        listen 443 ssl default_server;
        server_name _;

        access_log syslog:server=rsyslog.${DOMAIN},tag=default,severity=info json;
        error_log  syslog:server=rsyslog.${DOMAIN},tag=default,severity=info;

        location = /health {
            access_log off;
            return 200 "OK\n";
            add_header Content-Type text/plain;
        }

        location / {
            return 404;
        }
    }

    # Load all proxy host configs
    include /etc/nginx/conf.d/proxy_host/*.conf;
}
