# -----------------------------------------------------
# Deployment
# -----------------------------------------------------
THIS=$(realpath "$BASH_SOURCE")
HERE=$(dirname "$THIS")

export ENVIRONMENT_BASE=$(dirname "$THIS")
DEPLOYMENT_BASE=$(dirname "$ENVIRONMENT_BASE")

export ENVIRONMENT=$(basename "$ENVIRONMENT_BASE")
export DEPLOYMENT=$(basename "$DEPLOYMENT_BASE")

export CONFIGS="${ENVIRONMENT_BASE}/configs"
export SECRETS="${ENVIRONMENT_BASE}/secrets"

export STACK_PATH=$(realpath "$HERE/../../../")
export STACK_BASE=$(basename "$STACK_PATH" | sed 's/^stack\-//')
export STACK="${STACK_BASE}_${DEPLOYMENT}"

export CONTEXT="${ENVIRONMENT}.${DEPLOYMENT}"

# -----------------------------------------------------
# Images
# -----------------------------------------------------
NGINX_VERSION="1.31.3"
export NGINX_IMAGE="nginx:${NGINX_VERSION}"

# -----------------------------------------------------
# Configuration
# -----------------------------------------------------
# Replicas run on nodes labelled nginx_core_nginx, one per node.

# LoadBalancer IP (192.168.111.100-149), announced by kube-vip. Pi-hole's local DNS records point here.
export NGINX_LB_IP="192.168.111.101"

# Let's Encrypt, use https://acme-staging-v02.api.letsencrypt.org/directory to test.
export ACME_SERVER="https://acme-v02.api.letsencrypt.org/directory"

# Authelia (stack-authelia), asked about every request to a service with ":auth".
export NGINX_AUTHELIA_URL="http://authelia.authelia-core.svc.cluster.local:9091"

# Break-glass, "false" deploys every service without Authelia, e.g. while it's broken.
export NGINX_AUTH_ENABLED="true"

# Services are scheme:subdomain:host:port[:auth], ":auth" puts them behind Authelia. Hosts in the
# cluster need the full name (<service>.<namespace>.svc.cluster.local), they're resolved when a
# request is made.
export NGINX_SERVICES="\
http:nas:192.168.111.6:9999 \
http:jellyfin:192.168.111.6:8096 \
http:sonarr:192.168.111.6:8989 \
http:radarr:192.168.111.6:7878 \
http:bazarr:192.168.111.6:6767 \
http:profilarr:192.168.111.6:6868 \
http:prowlarr:192.168.111.6:9696 \
http:seerr:192.168.111.6:5055 \
http:qbittorrent:192.168.111.6:8080 \

https:pihole:pihole-web.pihole-core.svc.cluster.local:443 \
https:pihole1:pihole-0.pihole.pihole-core.svc.cluster.local:443 \
https:pihole2:pihole-1.pihole.pihole-core.svc.cluster.local:443 \
https:pihole3:pihole-2.pihole.pihole-core.svc.cluster.local:443 \
https:vault:vault-active.vault-core.svc.cluster.local:8200 \
https:vault1:vault-0.vault-internal.vault-core.svc.cluster.local:8200 \
https:vault2:vault-1.vault-internal.vault-core.svc.cluster.local:8200 \
https:vault3:vault-2.vault-internal.vault-core.svc.cluster.local:8200 \
https:rabbitmq:rabbitmq-broker.rabbitmq-core.svc.cluster.local:15671 \
https:alertmanager:alertmanager.grafana-core.svc.cluster.local:9093:auth \
https:victorialogs:victorialogs.grafana-core.svc.cluster.local:9428:auth \
https:victoriametrics:victoriametrics.grafana-core.svc.cluster.local:8428:auth \
https:vmagent:vmagent.grafana-core.svc.cluster.local:8429:auth \
https:vmalert:vmalert.grafana-core.svc.cluster.local:8880:auth \
http:homepage:homepage.homepage-core.svc.cluster.local:3000:auth \
http:lldap:lldap.lldap-core.svc.cluster.local:17170 \
