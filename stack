#!/usr/bin/env bash
#
# Nginx reverse proxy. A Deployment with one replica per labelled node behind a kube-vip
# LoadBalancer IP, with a wildcard cert from cert-manager.

# Variables substituted in k8s/*.yaml, anything else is left alone.
K8S_TEMPLATE_VARS='$STACK $DOMAIN $NGINX_IMAGE $NGINX_REPLICAS $NGINX_LB_IP $NGINX_CONFIG_CHECKSUM $ACME_SERVER $ACME_EMAIL'

# -----------------------------------------------------
# Helper functions
# -----------------------------------------------------

function check_stack_context {
  if [[ -z "${NGINX_LB_IP:-}" ]]; then
    log_warning "NGINX_LB_IP isn't set, nginx will only be reachable inside the cluster."
  else
    k8s_warn_kube_vip
  fi

  check_authelia
}

# Services with ':auth' need Authelia (stack-authelia). Without it they return 500 but the
# rest are fine, so it doesn't stop the deploy.
function check_authelia {
  local services host namespace ready

  services=$(auth_services)
  [[ -z "$services" ]] && return 0

  if [[ "$NGINX_AUTH_ENABLED" == "false" ]]; then
    log_warning "NGINX_AUTH_ENABLED is false, these services aren't behind Authelia:"
    list "$services"
    return 0
  fi

  # http://authelia.authelia-core.svc.cluster.local:9091 -> authelia-core
  host="${NGINX_AUTHELIA_URL#*://}"
  namespace=$(cut -d. -f2 <<< "${host%%:*}")

  ready=$(kubectl get statefulset authelia --namespace "$namespace" -o jsonpath='{.status.readyReplicas}' 2> /dev/null)

  if [[ -z "$ready" || "$ready" -eq 0 ]]; then
    log_warning "Authelia isn't ready in $namespace, these services will return 500 until it is:"
    list "$services"
  fi
}

# The certificate needs cert-manager (stack-cert-manager) and a Cloudflare token.
function can_issue_cert {
  if [[ -z "${CLOUDFLARE_API_TOKEN:-}" ]]; then
    log_warning "CLOUDFLARE_API_TOKEN isn't set in 'secrets.env', skipping the certificate."
    return 1
  fi

  if ! kubectl get crd certificates.cert-manager.io > /dev/null 2>&1; then
    log_warning "cert-manager isn't installed, skipping the certificate."
    return 1
  fi
}

# Lets nginx start before cert-manager has issued a cert. cert-manager replaces it once the
# Certificate is deployed and pods pick it up with a reload.
function placeholder_cert {
  local outdir

  if kubectl get secret nginx-tls --namespace "$K8S_NAMESPACE" > /dev/null 2>&1; then
    return 0
  fi

  log_warning "Creating a self-signed placeholder cert."
  outdir=$(mktemp -d)
  make-cert nginx "*.$DOMAIN" -o "$outdir" > /dev/null 2>&1

  kubectl create secret tls nginx-tls --namespace "$K8S_NAMESPACE" \
    --cert="$outdir/nginx.crt" --key="$outdir/nginx.key"

  rm -rf "$outdir"
}

function render {
  envsubst "$K8S_TEMPLATE_VARS" < "$STACK_PATH/k8s/$1"
}

# Usage: build_proxy_hosts <template> <outdir> <services>
# Services are "scheme:subdomain:host:port[:auth]", e.g. "https:pihole:pihole-web.pihole-core.svc.cluster.local:443".
# ':auth' puts the service behind Authelia, unless NGINX_AUTH_ENABLED is "false".
function build_proxy_hosts {
  local template="$1" outdir="$2" services="$3" svc auth

  for svc in $services; do
    UPSTREAM_SCHEME=$(echo "$svc" | cut -d: -f1)
    SERVICE_DOMAIN=$(echo "$svc" | cut -d: -f2)
    UPSTREAM_HOST=$(echo "$svc" | cut -d: -f3)
    UPSTREAM_PORT=$(echo "$svc" | cut -d: -f4)
    auth=$(echo "$svc" | cut -d: -f5 -s)

    AUTH_LOCATION=""
    AUTH_REQUEST=""

    if [[ "$auth" == "auth" ]]; then
      if [[ "$NGINX_AUTH_ENABLED" != "false" ]]; then
        AUTH_LOCATION="include /etc/nginx/snippets/authelia-location.conf;"
        AUTH_REQUEST="include /etc/nginx/snippets/authelia-authrequest.conf;"
      fi
    elif [[ -n "$auth" ]]; then
      log_error "Unknown option '$auth' for $SERVICE_DOMAIN, the only option is 'auth'."
      exit 1
    fi

    export UPSTREAM_SCHEME SERVICE_DOMAIN UPSTREAM_HOST UPSTREAM_PORT AUTH_LOCATION AUTH_REQUEST

    envsubst '$UPSTREAM_SCHEME $SERVICE_DOMAIN $DOMAIN $UPSTREAM_HOST $UPSTREAM_PORT $AUTH_LOCATION $AUTH_REQUEST' \
      < "$CONFIGS/$template" > "$outdir/$SERVICE_DOMAIN.conf"

    unset UPSTREAM_SCHEME SERVICE_DOMAIN UPSTREAM_HOST UPSTREAM_PORT AUTH_LOCATION AUTH_REQUEST
  done
}

# Prints the subdomains of the services with ':auth'.
function auth_services {
  local svc

  for svc in $NGINX_SERVICES $NGINX_WS_SERVICES; do
    if [[ "$(echo "$svc" | cut -d: -f5 -s)" == "auth" ]]; then
      echo "$svc" | cut -d: -f2
    fi
  done
}

# Usage: build_configs <outdir>
function build_configs {
  local outdir="$1"

  mkdir -p "$outdir/proxy_host"

  log_info "Generating main Nginx config..."
  envsubst '$DOMAIN' < "$CONFIGS/nginx.conf.tmpl" > "$outdir/nginx.conf"
  envsubst '$NGINX_AUTHELIA_URL' < "$CONFIGS/authelia-location.conf.tmpl" > "$outdir/authelia-location.conf"

  log_info "Generating proxy_host configs..."
  build_proxy_hosts service.conf.tmpl "$outdir/proxy_host" "$NGINX_SERVICES"

  log_info "Generating proxy_host configs with websockets enabled..."
  build_proxy_hosts ws_service.conf.tmpl "$outdir/proxy_host" "$NGINX_WS_SERVICES"
}

# Everything that needs a restart when it changes.
function config {
  local outdir="$1"

  kubectl create configmap nginx-config \
    --from-file=nginx.conf="$outdir/nginx.conf" \
    --from-file=logs.conf="$CONFIGS/logs.conf" \
    --from-file=authelia-location.conf="$outdir/authelia-location.conf" \
    --from-file=authelia-authrequest.conf="$CONFIGS/authelia-authrequest.conf" \
    --from-file=render-config.sh="$STACK_PATH/k8s/render-config.sh" \
    --from-file=reload-on-cert-change.sh="$STACK_PATH/k8s/reload-on-cert-change.sh" \
    --dry-run=client -o yaml
  echo "---"
  kubectl create configmap nginx-proxy-hosts --from-file="$outdir/proxy_host/" --dry-run=client -o yaml
}

# -----------------------------------------------------
# Override functions
# -----------------------------------------------------

# Keeps the namespace so the issued cert (nginx-tls), the Let's Encrypt account key and the
# Certificate survive a redeploy, rather than requesting a new cert every time.
function run_clean {
  log_info "'clean' has been overridden by stack."
  log_info "Removing nginx (namespace $K8S_NAMESPACE), keeping the certificate."
  kubectl delete deployment/nginx service/nginx configmap/nginx-config configmap/nginx-proxy-hosts \
    --namespace "$K8S_NAMESPACE" --ignore-not-found --wait=true
}

# Deleting the namespace removes the certificate as well.
function run_purge {
  log_info "'purge' has been overridden by stack."
  log_warning "Removing namespace $K8S_NAMESPACE, including the certificate."
  orchestrator_clean
  orchestrator_purge
}

# -----------------------------------------------------
# Commands
# -----------------------------------------------------

function command_cert_status {
  discover_stack_context

  if kubectl get certificate wildcard --namespace "$K8S_NAMESPACE" > /dev/null 2>&1; then
    kubectl describe certificate wildcard --namespace "$K8S_NAMESPACE"
  else
    log_warning "No Certificate, nginx is using a self-signed placeholder (see 'deploy')."
  fi
}

# -----------------------------------------------------
# Stack functions
# -----------------------------------------------------

function stack_check_env {
  if [ ! -d "$CONFIGS" ] || [ ! -d "$SECRETS" ]; then
    echo "Configs or secrets directory are missing from '$ENVIRONMENT_BASE'."
    exit 1
  fi
}

function stack_discover {
  export NGINX_REPLICAS=$(count "$NGINX_NODES")
  export ACME_EMAIL="${ACME_EMAIL:-${CLOUDFLARE_EMAIL:-}}"
}

function stack_env {
  echo
  echo "NGINX IMAGE = $NGINX_IMAGE"
  echo "NGINX NODES = ($NGINX_REPLICAS)"
  list "$NGINX_NODES"
  echo
  echo "NGINX IP    = $NGINX_LB_IP"
  echo "ACME SERVER = $ACME_SERVER"
  echo
  echo "AUTHELIA    = $NGINX_AUTHELIA_URL (enabled: $NGINX_AUTH_ENABLED)"
  echo "AUTH        = ($(auth_services | wc -l))"
  list "$(auth_services)"
  echo
}

function stack_deploy {
  local outdir manifests_config

  check_stack_context

  if (( NGINX_REPLICAS == 0 )); then
    log_error "No nodes are labelled ${STACK}_nginx."
    exit 1
  fi

  outdir=$(mktemp -d)
  build_configs "$outdir"

  manifests_config=$(config "$outdir")
  export NGINX_CONFIG_CHECKSUM=$(sha256sum <<< "$manifests_config" | cut -d' ' -f1)

  if can_issue_cert; then
    log_info "Deploying the certificate."
    {
      kubectl create secret generic cloudflare \
        --from-literal=api-token="$CLOUDFLARE_API_TOKEN" --dry-run=client -o yaml
      echo "---"
      render certificate.yaml
    } | kubectl apply --namespace "$K8S_NAMESPACE" -f -
  fi

  placeholder_cert

  log_info "Deploying $NGINX_REPLICAS Nginx replica(s) to $K8S_NAMESPACE."
  {
    echo "$manifests_config"
    echo "---"
    render services.yaml
    echo "---"
    render nginx.yaml
  } | kubectl apply --namespace "$K8S_NAMESPACE" -f -

  rm -rf "$outdir"

  kubectl rollout status deployment/nginx --namespace "$K8S_NAMESPACE" --timeout=10m
}
